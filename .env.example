# Copia este archivo a .env y rellena UNA de las dos opciones.
# El agente lee .env automaticamente al arrancar.

# Opcion 1 (original del repo, de pago): clave de OpenAI
# OPENAI_API_KEY=tu_clave_de_openai

# Opcion 2 (adaptacion para D.J., GRATIS): clave de Gemini
# Se consigue en https://aistudio.google.com -> "Get API key" -> "Create API key"
# No pide tarjeta. El modelo gemini-3.5-flash-lite es rapido y barato (gratis en su capa gratuita).
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_clave_de_gemini_aqui
# GEMINI_MODEL=gemini-3.5-flash-lite
